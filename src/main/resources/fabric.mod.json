{
  "schemaVersion": 1,
  "id": "booksmart",
  "version": "${version}",
  "name": "Book Smart",
  "description": "A smarter recipe book. Buttons stick to the variant you craft and remember it across sessions, and holding shift after a click crafts everything.",
  "authors": [
    "DC: rasmuskd, MC: WhoToldYou"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rasmus.booksmart.BookSmartClient"
    ],
    "modmenu": [
      "com.rasmus.booksmart.config.BookSmartModMenuIntegration"
    ]
  },
  "mixins": [
    "booksmart.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=26.1",
    "cloth-config2": ">=26.1.0",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  },
  "icon": "assets/booksmart/icon.png"
}
